# Copy to .env.local
# Password for /admin (at least 8 characters). Falls back to 12345678 for testing - always set it on a public server.
ADMIN_PASSWORD=12345678
# Public address of the site, used for sitemap, canonical links and social previews.
NEXT_PUBLIC_SITE_URL=https://gdbiler.dk
# Optional: where listings, enquiries, settings and uploaded photos are stored (default: ./data). Point it at a persistent disk.
# DATA_DIR=/var/data/gd-biler
